    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pokémon.Maze.Core\Pokémon.Maze.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\maze_grid.data" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\maze.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\sprite.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
