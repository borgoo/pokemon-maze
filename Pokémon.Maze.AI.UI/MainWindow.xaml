<Window x:Class="Pokémon.Maze.AI.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pokémon.Maze.AI.UI"
        mc:Ignorable="d"
        Title="Pokémon Maze - AI Autoplay"
        MinWidth="640"
        MinHeight="480">
    <Border Margin="8"
            BorderBrush="#444"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Viewbox Stretch="Uniform" MaxWidth="1280" MaxHeight="928">
            <Grid x:Name="MazeRoot" Width="640" Height="464" SnapsToDevicePixels="True">
                <Image x:Name="MazeBackground"
                       Width="640"
                       Height="464"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="ItemIconsCanvas" Width="640" Height="464" IsHitTestVisible="False" />
                <Canvas x:Name="SpriteCanvas" Width="640" Height="464" IsHitTestVisible="False">
                    <Image x:Name="SpriteImage"
                           Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="Collapsed" />
                </Canvas>
                <Border x:Name="FoundItemBanner"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Margin="16,12,16,0"
                        Padding="12,8"
                        Background="#E6222222"
                        CornerRadius="4"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="FoundItemText"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Normal"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Viewbox>
    </Border>
</Window>
